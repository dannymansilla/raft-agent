OPENROUTER_API_KEY=your-key-here
# Optional overrides
# ORDER_API_URL=http://localhost:5001
# OPENROUTER_MODEL=openai/gpt-oss-120b:exacto
# LLM_BASE_URL=https://openrouter.ai/api/v1   (any OpenAI-compatible endpoint, e.g. a self-hosted gpt-oss)
# REASONING_EFFORT=low   (low | medium | high; empty = provider default)
# MAX_LLM_CALLS=200      (records per query that may go to the LLM; the rest are reported as skipped)
